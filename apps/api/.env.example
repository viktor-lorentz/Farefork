# Routing: osrm (public demo server, falls back to an estimate) or estimate (straight line, offline)
ROUTER=osrm
OSRM_URL=https://router.project-osrm.org

# Sent to Photon and OSRM. Keep it generic.
GEO_USER_AGENT=Farefork/0.1 (development build)
UPSTREAM_TIMEOUT_MS=5000
NOMINATIM_URL=
RESTAURANTS=
